#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <190>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <29 30 31 32 44 43 42 41>;
            retro-tap;
        };

        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            label = "HT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };
    };

    macros {
        TSD0: TSD0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(R) &kp E &kp D &kp N1 &kp N9 &kp N7 &kp N0 &kp LS(H) &kp O &kp R &kp S &kp E &kp EXCL>;
            label = "TSD0";
        };

        TSD1: TSD1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(P) &kp R &kp O &kp V &kp I &kp N &kp C &kp E &kp N4 &kp N4 &kp LS(D) &kp E &kp D &kp U &kp C &kp T &kp E &kp D>;
            label = "TSD1";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Operator+ {
            label = "op+";
            display-name = "opn";
            bindings = <
&kp EQUAL       &kp NUMBER_1      &kp NUMBER_2  &kp NUMBER_3    &kp NUMBER_4    &kp NUMBER_5  &to 0                                                           &mo 5        &kp NUMBER_6  &kp N7           &kp N8           &kp N9            &kp N0                     &kp MINUS
&kp TAB         &kp Q             &kp W         &kp E           &kp R           &kp T         &mo 1                                                           &mo 3        &kp Y         &kp U            &kp I            &kp O             &kp P                      &kp BSLH
&kp ESC         &hm LEFT_SHIFT A  &hm LCTRL S   &hm LEFT_ALT D  &hm LEFT_GUI F  &kp G         &mo 2            &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &mo 4        &kp H         &hm RIGHT_GUI J  &hm RIGHT_ALT K  &hm RCTRL L       &hm RIGHT_SHIFT SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &kp Z             &kp X         &kp C           &kp V           &kp B                                     &kp HOME      &kp PG_UP                          &kp N         &kp M            &kp COMMA        &kp DOT           &kp FSLH                   &kp RSHFT
&mo 2           &kp GRAVE         &kp CAPS      &kp LEFT        &kp RIGHT                     &lt 1 BACKSPACE  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &lt 2 SPACE                &kp UP_ARROW     &kp DOWN         &kp LEFT_BRACKET  &kp RIGHT_BRACKET          &mo 1
            >;
        };

        Extended {
            display-name = "Ex";
            bindings = <
&none      &none         &none         &none             &none              &none        &to 0                                                      &mo 4   &none         &none           &none            &none                 &none                  &none
&kp PLUS   &kp EXCL      &kp AT        &kp HASH          &kp DOLLAR         &kp PERCENT  &trans                                                     &trans  &kp CARET     &kp AMPS        &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE
&kp EQUAL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4       &kp N5       &trans  &kp LCTRL  &kp LALT      &kp RIGHT_GUI  &kp RCTRL  &trans  &kp NUMBER_6  &kp N7          &kp NUMBER_8     &kp N9                &kp N0                 &kp MINUS
&kp LSHFT  &kp TILDE     &kp CAPS      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none                           &kp HOME      &kp PAGE_UP                       &none         &kp LEFT_BRACE  &kp RIGHT_BRACE  &none                 &kp GRAVE              &kp RSHFT
&trans     &none         &none         &none             &none                           &trans  &trans     &kp END       &kp PAGE_DOWN  &trans     &trans                &TSD0           &TSD1            &none                 &none                  &trans
            >;
        };

        Media {
            display-name = "Fn";
            bindings = <
&none  &kp F1  &kp F2             &kp F3      &kp F4           &kp F5      &to 0                                       &mo 4   &kp F6                  &kp F7         &kp F8           &kp F9              &kp F10        &kp F11
&none  &none   &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &none       &trans                                      &trans  &none                   &kp HOME       &kp C_AC_SEARCH  &kp END             &none          &kp F12
&none  &none   &kp C_PREVIOUS     &kp K_STOP  &kp C_PLAY       &kp C_NEXT  &trans  &trans  &trans      &trans  &trans  &trans  &kp LEFT                &kp DOWN       &kp UP_ARROW     &kp RIGHT           &kp RC(EQUAL)  &kp F13
&none  &none   &none              &none       &none            &none                       &trans      &trans                  &kp C_AL_PREVIOUS_TASK  &kp PAGE_DOWN  &kp PAGE_UP      &kp C_AL_NEXT_TASK  &kp RC(MINUS)  &kp F14
&none  &none   &none              &none       &none                        &trans  &trans  &trans      &trans  &trans  &trans                          &none          &none            &none               &none          &none
            >;

            label = "fn";
        };

        original {
            label = "original";
            display-name = "default-";
            bindings = <
&kp EQUAL       &kp N1     &kp N2    &kp N3          &kp N4           &kp N5  &to 0                                                           &mo 4        &kp N6  &kp N7  &kp N8          &kp N9            &kp N0             &kp MINUS
&kp TAB         &kp Q      &kp W     &kp E           &kp R            &kp T   &trans                                                          &trans       &kp Y   &kp U   &kp I           &kp O             &kp P              &kp BSLH
&kp ESC         &kp A      &kp S     &kp D           &kp F            &kp G   &trans           &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &trans       &kp H   &kp J   &kp K           &kp L             &kp SEMICOLON      &kp SQT
&kp LEFT_SHIFT  &kp Z      &kp X     &kp C           &kp V            &kp B                               &kp HOME      &kp PG_UP                          &kp N   &kp M   &kp COMMA       &kp DOT           &kp FSLH           &kp RSHFT
&mo 2           &kp GRAVE  &kp CAPS  &kp LEFT_ARROW  &kp RIGHT_ARROW          &lt 1 BACKSPACE  &trans     &kp END       &kp PG_DN  &trans     &lt 2 SPACE          &kp UP  &kp DOWN_ARROW  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &mo 1
            >;
        };

        layer_4 {
            label = "original2";
            display-name = "default-";
            bindings = <
&kp EQUAL       &kp N1     &kp N2    &kp N3          &kp N4           &kp N5  &to 0                                                           &mo 4        &kp N6  &kp N7  &kp N8          &kp N9            &kp N0             &kp MINUS
&kp TAB         &kp Q      &kp W     &kp E           &kp R            &kp T   &trans                                                          &trans       &kp Y   &kp U   &kp I           &kp O             &kp P              &kp BSLH
&kp ESC         &kp A      &kp S     &kp D           &kp F            &kp G   &trans           &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &trans       &kp H   &kp J   &kp K           &kp L             &kp SEMICOLON      &kp SQT
&kp LEFT_SHIFT  &kp Z      &kp X     &kp C           &kp V            &kp B                               &kp HOME      &kp PG_UP                          &kp N   &kp M   &kp COMMA       &kp DOT           &kp FSLH           &kp RSHFT
&mo 2           &kp GRAVE  &kp CAPS  &kp LEFT_ARROW  &kp RIGHT_ARROW          &lt 1 BACKSPACE  &trans     &kp END       &kp PG_DN  &trans     &lt 2 SPACE          &kp UP  &kp DOWN_ARROW  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &mo 1
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &to 0                                               &trans           &none        &rgb_ug RGB_SPI  &rgb_ug RGB_ON  &bl BL_INC  &bl BL_DEC  &bl BL_TOG
&none           &none         &none         &none         &sys_reset    &none         &to 1                                               &to 3            &none        &none            &none           &none       &none       &none
&studio_unlock  &none         &soft_off     &none         &none         &none         &to 2  &none  &out OUT_USB      &trans  &none       &to 4            &none        &none            &none           &none       &none       &none
&none           &none         &none         &none         &none         &bootloader                 &out OUT_BLE      &none                                &bootloader  &none            &none           &none       &none       &none
&trans          &none         &none         &none         &none                       &none  &none  &out OUT_TOG      &none   &bl BL_TOG  &rgb_ug RGB_TOG               &bl BL_INC       &bl BL_DEC      &bl BL_TOG  &none       &trans
            >;
        };
    };
};
